{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/assurance-plan.schema.json",
  "title": "AssurancePlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "created_at", "candidate_ref", "evaluation_contract_ref", "evaluation_result_ref", "required_tests", "evidence_requirements", "controls", "gate_blockers", "extensions"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "created_at": {"type": "string", "format": "date-time"},
    "candidate_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "evaluation_contract_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "evaluation_result_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "required_tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "gate_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "reason", "owner"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "status": {"enum": ["clear", "blocked", "requires_review"]},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "owner", "status", "evidence_refs"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["required", "satisfied", "blocked", "not_applicable"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
