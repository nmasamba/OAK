{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/common.schema.json",
  "title": "OAK common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[A-Fa-f0-9]{64}|sha512:[A-Fa-f0-9]{128})$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9.-]+/[A-Za-z0-9._-]+$"},
      "additionalProperties": true
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_type", "checked_at", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "uri": {"type": ["string", "null"], "format": "uri-reference"},
        "version": {"type": ["string", "null"]},
        "source_type": {
          "enum": ["authoritative", "official_guidance", "measured", "stakeholder", "vendor_claim", "community_claim", "inference"]
        },
        "checked_at": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "content_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "provenanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence", "rationale", "evidence_refs", "materiality", "confirmation_required"],
      "properties": {
        "source": {
          "enum": ["explicit", "inferred_from_brief", "domain_default", "policy", "measured", "unknown", "user_correction"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "materiality": {"enum": ["low", "medium", "high", "critical"]},
        "confirmation_required": {"type": "boolean"},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "uri": {"type": ["string", "null"], "format": "uri-reference"},
        "media_type": {"type": ["string", "null"]}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "expression", "result", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "kind": {"enum": ["hard", "soft"]},
        "expression": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "value", "unit", "weight", "confidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "direction": {"enum": ["minimize", "maximize"]},
        "value": {"type": "number"},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "estimator_ref": {"type": ["string", "null"]}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "decision", "object_digest", "decided_at"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "approver": {"type": ["string", "null"]},
        "role": {"type": "string", "minLength": 1},
        "decision": {"enum": ["approved", "rejected", "changes_requested", "revoked", "pending"]},
        "object_digest": {"$ref": "#/$defs/digest"},
        "target_id": {"type": ["string", "null"]},
        "decided_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "moneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "low", "high", "period"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "low": {"type": "number", "minimum": 0},
        "most_likely": {"type": ["number", "null"], "minimum": 0},
        "high": {"type": "number", "minimum": 0},
        "period": {"enum": ["one_off", "decision", "hour", "day", "month", "year"]}
      }
    },
    "signatureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "key_id", "algorithm", "public_key_base64", "trust_level", "signature_base64"],
      "properties": {
        "role": {"enum": ["plan-signer", "approver", "runner", "extension-steward"]},
        "key_id": {"$ref": "#/$defs/digest"},
        "algorithm": {"const": "ed25519"},
        "public_key_base64": {"type": "string", "minLength": 40, "maxLength": 60},
        "trust_level": {"enum": ["development"]},
        "signature_base64": {"type": "string", "minLength": 80, "maxLength": 100}
      }
    }
  }
}
