{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/source-record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "created_at", "trust", "format", "original_name", "content_ref", "size_bytes", "normalization", "extensions"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "created_at": {"type": "string", "format": "date-time"},
    "trust": {"const": "untrusted"},
    "format": {"enum": ["yaml", "json", "markdown", "text"]},
    "original_name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"},
    "content_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unicode", "line_endings"],
      "properties": {
        "unicode": {"const": "NFC"},
        "line_endings": {"const": "LF"}
      }
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
