{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "case_id",
    "pack_ref",
    "subject_digest",
    "evaluated_at",
    "effective",
    "outcome",
    "rule_results",
    "reasons",
    "obligations",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "status": {
      "enum": [
        "evaluated"
      ]
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "pack_ref": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "subject_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective": {
      "const": true
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "review_required",
        "unknown"
      ]
    },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "matched",
          "outcome",
          "reason_code",
          "obligations"
        ],
        "properties": {
          "rule_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "matched": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "allow",
              "deny",
              "review_required",
              "unknown"
            ]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
          },
          "obligations": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 40,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
      }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
