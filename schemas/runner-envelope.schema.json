{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/runner-envelope.schema.json",
  "title": "RunnerDispatchEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "id", "kind", "case_id", "tenant_id", "environment", "plan_ref", "bundle_ref", "verification_policy_ref", "plan_signature_ref", "approval_refs", "target_id", "target_fingerprint", "requested_kinds", "lease", "issued_at", "signature", "extensions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "protocol_version": {"const": "0.1.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "kind": {"const": "dispatch_envelope"},
    "case_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "environment": {"enum": ["development", "validation", "staging"]},
    "plan_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "bundle_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "verification_policy_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "plan_signature_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "approval_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "common.schema.json#/$defs/artifactRef"}
    },
    "target_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "target_fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
    "requested_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["inventory", "validate", "render", "plan", "verify", "apply", "rollback", "destroy"]}
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "nonce", "issued_at", "expires_at", "heartbeat_seconds"],
      "properties": {
        "lease_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "nonce": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "heartbeat_seconds": {"type": "integer", "minimum": 5, "maximum": 300}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "signature": {"$ref": "common.schema.json#/$defs/signatureBlock"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
