{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/architecture-pattern.schema.json",
  "title": "ArchitecturePattern",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "variant", "description", "roles", "edges", "component_requirements", "hard_requirements", "extensions"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "variant": {"enum": ["simpler_baseline", "minimum_sufficient", "balanced_enterprise", "high_assurance_sovereign"]},
    "description": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "component_category", "required_capability", "data_classifications"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "role": {"type": "string", "minLength": 1},
          "component_category": {"enum": ["software", "model", "dataset", "adapter", "blueprint", "policy_pack", "external_service"]},
          "required_capability": {"type": "string", "minLength": 1},
          "data_classifications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "interface", "data", "security"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "interface": {"type": "string"},
          "data": {"type": "string"},
          "security": {"type": "string"}
        }
      }
    },
    "component_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "manifest_id", "purpose", "required"],
        "properties": {
          "role_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "manifest_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "hard_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
