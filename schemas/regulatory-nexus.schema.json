{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/regulatory-nexus.schema.json",
  "title": "RegulatoryNexus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "system_intent_ref", "entities", "activities", "affected_person_locations", "data_locations", "lifecycle", "claims_provenance", "evidence", "owner", "last_reviewed_at", "extensions"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "status": {"enum": ["draft", "review_required", "approved", "superseded", "retired"]},
    "system_intent_ref": {"type": "string"},
    "entities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "legal_name", "established_in", "roles"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "legal_name": {"type": "string"},
          "established_in": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
          "roles": {"type": "array", "items": {"enum": ["provider", "deployer", "importer", "distributor", "product_manufacturer", "authorised_representative", "gpai_provider", "downstream_provider", "operator", "employer", "public_authority", "controller", "processor", "other", "unknown"]}, "minItems": 1, "uniqueItems": true},
          "offered_under_own_name": {"type": ["boolean", "null"]}
        }
      }
    },
    "activities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "entity_id", "countries", "intended_date"],
        "properties": {
          "type": {"enum": ["develop", "place_on_market", "put_into_service", "operate", "integrate", "support", "output_use", "real_world_test", "material_change"]},
          "entity_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "countries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}, "uniqueItems": true},
          "intended_date": {"type": ["string", "null"], "format": "date"}
        }
      }
    },
    "affected_person_locations": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}, "uniqueItems": true},
    "data_locations": {
      "type": "object", "additionalProperties": false,
      "required": ["processing", "storage", "transfers"],
      "properties": {
        "processing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "storage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transfers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "embedded_in_product", "third_party_offering", "material_change_date"],
      "properties": {
        "stage": {"enum": ["research", "testing", "regulatory_sandbox", "real_world_testing", "pilot", "production", "retired"]},
        "embedded_in_product": {"type": ["boolean", "null"]},
        "third_party_offering": {"type": ["boolean", "null"]},
        "material_change_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "claims_provenance": {
      "type": "object",
      "propertyNames": {"pattern": "^/"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/provenanceRecord"}
    },
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidenceRef"}},
    "owner": {"type": ["string", "null"]},
    "last_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
