{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/research-review.schema.json",
  "title": "ResearchReview",
  "description": "A recorded human decision about one unvetted research item (Sprint 14, ADR-0018): accept or reject, with a rationale, bound to the snapshot's digest and the item's response digest. An accept makes the item eligible under the research gates for comparison only; it never approves a component for a context, selects a design or installs anything.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "case_id", "snapshot_ref", "item_id", "item_response_digest", "decision", "rationale", "actor", "recorded_at", "extensions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "case_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "snapshot_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "item_response_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "decision": {"enum": ["accept", "reject"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "actor": {"type": "string", "minLength": 1, "maxLength": 160},
    "recorded_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
