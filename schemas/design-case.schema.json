{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/design-case.schema.json",
  "title": "DesignCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "tenant_id",
    "created_at",
    "updated_at",
    "interface_origin",
    "brief_refs",
    "intent_ref",
    "decision_cost_model_ref",
    "regulatory_nexus_ref",
    "evaluation_contract_ref",
    "assumptions",
    "unresolved_questions",
    "candidate_refs",
    "selected_candidate_ref",
    "assurance_plan_ref",
    "deployment_bundle_ref",
    "runner_plan_ref",
    "approvals",
    "audit_head",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "status": {
      "enum": [
        "draft",
        "needs_confirmation",
        "ready_for_candidates",
        "candidates_ready",
        "candidate_selected",
        "assurance_planned",
        "bundle_compiled",
        "deployment_approved",
        "deployed",
        "observing",
        "closed"
      ]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "interface_origin": {"enum": ["web", "api", "cli", "mcp", "portal", "import"]},
    "brief_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/artifactRef"}
    },
    "intent_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "decision_cost_model_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "regulatory_nexus_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "evaluation_contract_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assumption"}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    },
    "candidate_refs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/artifactRef"}
    },
    "selected_candidate_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "assurance_plan_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "deployment_bundle_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "runner_plan_ref": {"$ref": "#/$defs/nullableArtifactRef"},
    "approvals": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/approval"}
    },
    "audit_head": {
      "anyOf": [
        {"$ref": "common.schema.json#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "$defs": {
    "nullableArtifactRef": {
      "anyOf": [
        {"$ref": "common.schema.json#/$defs/artifactRef"},
        {"type": "null"}
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "statement", "source", "confidence", "materiality", "status"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^/"},
        "statement": {"type": "string", "minLength": 1},
        "source": {"enum": ["explicit", "inferred_from_brief", "domain_default", "policy", "measured", "unknown", "user_correction"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "materiality": {"enum": ["low", "medium", "high", "critical"]},
        "status": {"enum": ["proposed", "confirmed", "corrected", "rejected", "accepted_risk"]}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "question", "reason", "materiality", "blocking_stage", "status"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^/"},
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "materiality": {"enum": ["low", "medium", "high", "critical"]},
        "blocking_stage": {"enum": ["none", "interpret", "clarify", "assess", "expand", "solve", "compare", "assure", "compile", "verify"]},
        "status": {"enum": ["open", "bounded", "resolved", "accepted_risk"]}
      }
    }
  }
}
