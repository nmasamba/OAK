{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/model-configuration.schema.json",
  "title": "ModelConfiguration",
  "description": "The user's non-secret model-provider configuration: which backend holds the Hugging Face token (never the token), the model and provider route pinned for each family, the discovery snapshot, and — once the token has been checked — the verdict Hugging Face gave with the time it gave it. By construction no property may carry a credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "selection", "credential_sources", "provider_policy", "discovery", "extensions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/family"},
      "patternProperties": {
        "^[a-z]+$": {"$ref": "#/$defs/selection"}
      }
    },
    "credential_sources": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/family"},
      "patternProperties": {
        "^[a-z]+$": {"enum": ["keychain", "file", "env", "none"]}
      }
    },
    "provider_policy": {"enum": ["cheapest", "fastest"]},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/family"},
      "patternProperties": {
        "^[a-z]+$": {"$ref": "#/$defs/discoverySnapshot"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {"$ref": "#/$defs/family"},
      "patternProperties": {
        "^[a-z]+$": {"$ref": "#/$defs/verification"}
      }
    },
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "$defs": {
    "family": {"enum": ["huggingface", "local"]},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "providerName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "provider_route", "selected_at"],
      "properties": {
        "model_id": {"$ref": "#/$defs/modelId"},
        "provider_route": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/providerName"}]},
        "selected_at": {"type": "string", "format": "date-time"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "checked_at", "method"],
      "properties": {
        "verdict": {"enum": ["accepted", "rejected", "scope_limited", "unreachable", "unverifiable"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "method": {"enum": ["hub_whoami_v2", "models_list", "interpretation", "unknown"]},
        "token_role": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 40}]},
        "inference_permission": {"oneOf": [{"type": "null"}, {"type": "boolean"}]},
        "can_pay": {"oneOf": [{"type": "null"}, {"type": "boolean"}]},
        "is_pro": {"oneOf": [{"type": "null"}, {"type": "boolean"}]},
        "reason": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 400}]},
        "credential_fingerprint": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 64}]},
        "last_attempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "at"],
          "properties": {
            "verdict": {"enum": ["unreachable", "unverifiable"]},
            "at": {"type": "string", "format": "date-time"},
            "reason": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 400}]}
          }
        }
      }
    },
    "discoverySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fetched_at", "source", "recommended", "filtered_out_count", "models"],
      "properties": {
        "fetched_at": {"type": "string", "format": "date-time"},
        "source": {"enum": ["live", "pinned"]},
        "recommended": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/modelId"}]},
        "filtered_out_count": {"type": "integer", "minimum": 0},
        "models": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "display_name", "created", "licence", "data_use", "providers"],
            "properties": {
              "id": {"$ref": "#/$defs/modelId"},
              "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
              "created": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
              "licence": {"enum": ["apache-2.0", "mit", "bsd-3-clause", "other", "unknown"]},
              "data_use": {"enum": ["trains_on_inputs", "not_used_for_training", "unknown"]},
              "providers": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["provider", "supports_structured_output", "output_price_per_million"],
                  "properties": {
                    "provider": {"$ref": "#/$defs/providerName"},
                    "supports_structured_output": {"type": "boolean"},
                    "output_price_per_million": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
                    "is_free": {"type": "boolean"},
                    "throughput": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
