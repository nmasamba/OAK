{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/extension-activation.schema.json",
  "title": "ExtensionActivation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "extension_id",
    "extension_version",
    "manifest_digest",
    "activated_at",
    "activated_by",
    "verification",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "extension_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "extension_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "manifest_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "result",
              "detail"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,80}$"
              },
              "result": {
                "enum": [
                  "pass"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
