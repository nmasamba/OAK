{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/policy-pack.schema.json",
  "title": "PolicyPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "name",
    "description",
    "owner",
    "scope",
    "effective_from",
    "expires_at",
    "source_version",
    "evidence",
    "licence",
    "rules",
    "tests",
    "review",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "superseded",
        "retired"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictions",
        "domains"
      ],
      "properties": {
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceRef"
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_expression"
      ],
      "properties": {
        "spdx_expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri-reference"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/packTest"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_review_status",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "owner_review_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signatureBlock"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "outcome",
        "reason_code",
        "when",
        "obligations"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcome": {
          "enum": [
            "allow",
            "deny",
            "review_required"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "obligations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer",
            "operator"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(/[^/~]*(~[01][^/~]*)*)+$",
              "maxLength": 500
            },
            "operator": {
              "enum": [
                "equals",
                "not_equals",
                "in",
                "not_in",
                "less_or_equal",
                "greater_or_equal",
                "exists",
                "absent",
                "contains",
                "subset_of"
              ]
            },
            "value": {
              "$ref": "#/$defs/jsonValue"
            }
          }
        }
      ]
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "packTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "subject",
        "expected_outcome",
        "expected_reason_codes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject": {
          "type": "object"
        },
        "expected_outcome": {
          "enum": [
            "allow",
            "deny",
            "review_required",
            "unknown"
          ]
        },
        "expected_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
          }
        }
      }
    }
  }
}
