{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/architecture-candidate.schema.json",
  "title": "ArchitectureCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "variant", "status", "intent_ref", "evaluation_contract_ref", "generated_at", "generator_version", "topology", "components", "hard_constraints", "objectives", "pareto", "assumptions", "omissions", "risks", "operational_requirements", "rejection_reasons", "evidence_refs", "extensions"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "variant": {"enum": ["minimum_sufficient", "balanced_enterprise", "high_assurance_sovereign", "edge_appliance", "other"]},
    "status": {"enum": ["generated", "feasible", "infeasible", "recommended", "selected", "rejected", "superseded"]},
    "intent_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "evaluation_contract_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator_version": {"type": "string"},
    "topology": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "edges", "systems_of_record", "trust_boundaries"],
      "properties": {
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "role", "component_ref", "data_classifications"],
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/identifier"},
              "role": {"type": "string"},
              "component_ref": {"type": ["string", "null"]},
              "data_classifications": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["from", "to", "interface", "data", "security"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "interface": {"type": "string"},
              "data": {"type": "string"},
              "security": {"type": "string"}
            }
          }
        },
        "systems_of_record": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "trust_boundaries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["manifest_id", "version", "digest", "purpose", "required"],
        "properties": {
          "manifest_id": {"type": "string"},
          "version": {"type": "string"},
          "digest": {"$ref": "common.schema.json#/$defs/digest"},
          "purpose": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "hard_constraints": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/constraint"}},
    "objectives": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/objective"}},
    "pareto": {
      "type": "object", "additionalProperties": false,
      "required": ["frontier_member", "dominated_by", "preference_weights_ref", "sensitivity_summary"],
      "properties": {
        "frontier_member": {"type": "boolean"},
        "dominated_by": {"type": "array", "items": {"type": "string"}},
        "preference_weights_ref": {"type": ["string", "null"]},
        "sensitivity_summary": {"type": "string"}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "operational_requirements": {"type": "array", "items": {"type": "string"}},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
