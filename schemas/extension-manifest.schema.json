{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/extension-manifest.schema.json",
  "title": "ExtensionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "extension_class",
    "name",
    "description",
    "owner",
    "sdk_interface_version",
    "compatibility",
    "payload",
    "licence",
    "supply_chain",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "extension_class": {
      "enum": [
        "policy-pack",
        "deployment-adapter",
        "component-manifest",
        "architecture-pattern",
        "runner-adapter"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sdk_interface_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_oak_version",
        "maximum_oak_version"
      ],
      "properties": {
        "minimum_oak_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "maximum_oak_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "payload_digest"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "media_type"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][A-Za-z0-9._/-]{0,240}$"
              },
              "digest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "media_type": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            }
          }
        },
        "payload_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_expression"
      ],
      "properties": {
        "spdx_expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri-reference"
        }
      }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_status",
        "provenance_status",
        "sbom_status"
      ],
      "properties": {
        "signature_status": {
          "enum": [
            "verified",
            "present_unverified",
            "absent",
            "unknown"
          ]
        },
        "provenance_status": {
          "enum": [
            "verified",
            "present_unverified",
            "absent",
            "unknown"
          ]
        },
        "sbom_status": {
          "enum": [
            "verified",
            "present_unverified",
            "absent",
            "unknown"
          ]
        },
        "provenance_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri-reference"
        },
        "sbom_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri-reference"
        }
      }
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signatureBlock"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
