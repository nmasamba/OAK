{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/deployment-bundle.schema.json",
  "title": "DeploymentBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "created_at", "architecture_decision_ref", "intent_ref", "evaluation_contract_ref", "target", "adapter", "component_lock", "artifacts", "secret_references", "preflight_checks", "procedures", "supply_chain", "approval_policy", "compatibility", "expires_at", "extensions"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "status": {"enum": ["draft", "compiled", "validated", "deployment_approved", "deployed", "revoked", "retired"]},
    "created_at": {"type": "string", "format": "date-time"},
    "architecture_decision_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "intent_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "evaluation_contract_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "fingerprint", "environment", "tenant_id", "network_mode"],
      "properties": {
        "class": {"enum": ["local", "kubernetes", "edge", "appliance", "hpc", "air_gapped", "other"]},
        "fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
        "environment": {"enum": ["development", "validation", "staging", "production"]},
        "tenant_id": {"type": "string"},
        "network_mode": {"type": "string"}
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "component_lock": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["manifest_id", "version", "digest", "licence_decision", "source"],
        "properties": {
          "manifest_id": {"type": "string"},
          "version": {"type": "string"},
          "digest": {"$ref": "common.schema.json#/$defs/digest"},
          "licence_decision": {"enum": ["allowed", "exception_approved", "blocked"]},
          "source": {"type": "string"}
        }
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/artifactRef"}},
    "secret_references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "provider", "reference", "scope"],
        "properties": {
          "name": {"type": "string"},
          "provider": {"type": "string"},
          "reference": {"type": "string"},
          "scope": {"type": "string"}
        }
      }
    },
    "preflight_checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "required", "failure_action"],
        "properties": {
          "id": {"type": "string"},
          "category": {"enum": ["capacity", "compatibility", "network", "storage", "identity", "certificate", "policy", "backup", "rollback", "other"]},
          "required": {"type": "boolean"},
          "failure_action": {"enum": ["block", "warn", "require_approval"]}
        }
      }
    },
    "procedures": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "install", "verify", "backup", "restore", "rollback", "upgrade", "downgrade", "uninstall", "decommission"],
      "properties": {
        "plan": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "install": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "verify": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "backup": {"type": "array", "items": {"type": "string"}},
        "restore": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "upgrade": {"type": "array", "items": {"type": "string"}},
        "downgrade": {"type": "array", "items": {"type": "string"}},
        "uninstall": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "decommission": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "supply_chain": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_digest", "sbom_ref", "provenance_ref", "signature_ref", "verification_policy_ref"],
      "properties": {
        "bundle_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "sbom_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
        "provenance_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
        "signature_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
        "verification_policy_ref": {"$ref": "common.schema.json#/$defs/artifactRef"}
      }
    },
    "approval_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["required_roles", "separation_of_duties", "target_bound", "digest_bound"],
      "properties": {
        "required_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "separation_of_duties": {"type": "boolean"},
        "target_bound": {"type": "boolean"},
        "digest_bound": {"type": "boolean"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_oak_version", "target_constraints", "known_incompatibilities"],
      "properties": {
        "minimum_oak_version": {"type": "string"},
        "target_constraints": {"type": "array", "items": {"type": "string"}},
        "known_incompatibilities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
