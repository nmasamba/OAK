{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/target-profile.schema.json",
  "title": "TargetProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_profile_version",
    "id",
    "status",
    "environment",
    "tenant_id",
    "platform",
    "capacity",
    "network",
    "permissions",
    "secrets",
    "notes"
  ],
  "properties": {
    "target_profile_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "status": {
      "enum": [
        "non-production-fixture",
        "non-production-local"
      ]
    },
    "environment": {
      "enum": [
        "development",
        "validation",
        "staging"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "architecture",
        "accelerators",
        "drivers",
        "container_runtime"
      ],
      "properties": {
        "operating_system": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "container_runtime": {
          "type": "string"
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ram_gib",
        "storage_gib"
      ],
      "properties": {
        "ram_gib": {
          "type": "number",
          "minimum": 0
        },
        "storage_gib": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "inbound_control_plane"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local",
            "isolated-no-egress",
            "outbound-only",
            "disconnected",
            "air-gapped"
          ]
        },
        "inbound_control_plane": {
          "type": "boolean"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_allowed",
        "allowed_operations"
      ],
      "properties": {
        "mutation_allowed": {
          "type": "boolean"
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "enum": [
              "inventory",
              "validate",
              "render",
              "plan",
              "verify",
              "apply",
              "rollback",
              "destroy"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_acknowledgement"
      ],
      "properties": {
        "mutation_acknowledgement": {
          "description": "The operator's acknowledgement of what a mutation may do on this target. `isolated-non-production-fixture-only` creates network-isolated containers and never starts them; `isolated-non-production-hardened-start` also starts them under the runner's fixed hardening flags (ADR-0017).",
          "enum": [
            "isolated-non-production-fixture-only",
            "isolated-non-production-hardened-start"
          ]
        },
        "container_image_reference": {
          "description": "Deprecated: superseded by component_images. A compile refuses a profile that still declares it rather than silently installing a stand-in for the whole architecture.",
          "deprecated": true,
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "pattern": "^[a-z0-9][a-zA-Z0-9./_:@-]*$"
        },
        "container_image_digest": {
          "description": "Deprecated: superseded by component_images.",
          "deprecated": true,
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "component_images": {
          "description": "The digest-pinned image the operator acknowledges for each catalogue component this target may install. A locked component with no entry fails compile-time preflight; nothing falls back to another image.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest_id",
              "image_reference",
              "image_digest"
            ],
            "properties": {
              "manifest_id": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "image_reference": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300,
                "pattern": "^[a-z0-9][a-zA-Z0-9./_:-]*$"
              },
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        },
        "allowed_registries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-z0-9][a-zA-Z0-9.:-]*$"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_references"
      ],
      "properties": {
        "allowed_references": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_profile_version": {
            "const": "0.1.0"
          }
        },
        "required": [
          "target_profile_version"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "non-production-fixture"
          },
          "permissions": {
            "properties": {
              "mutation_allowed": {
                "const": false
              },
              "allowed_operations": {
                "items": {
                  "enum": [
                    "inventory",
                    "validate",
                    "render",
                    "plan",
                    "verify"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "permissions": {
            "properties": {
              "mutation_allowed": {
                "const": true
              }
            },
            "required": [
              "mutation_allowed"
            ]
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "required": [
          "execution"
        ],
        "properties": {
          "target_profile_version": {
            "const": "0.2.0"
          },
          "status": {
            "const": "non-production-local"
          },
          "environment": {
            "enum": [
              "development",
              "validation"
            ]
          }
        }
      }
    }
  ]
}
