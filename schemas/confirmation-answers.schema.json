{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/confirmation-answers.schema.json",
  "title": "ConfirmationAnswers",
  "type": "object",
  "additionalProperties": false,
  "required": ["answers_version", "design_case_id", "answers"],
  "properties": {
    "answers_version": {"const": "0.1.0"},
    "design_case_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "decision", "value", "rationale"],
        "properties": {
          "question_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "decision": {"enum": ["confirm", "correct", "reject", "accept_risk"]},
          "value": {},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  }
}
