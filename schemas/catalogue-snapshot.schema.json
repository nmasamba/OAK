{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/catalogue-snapshot.schema.json",
  "title": "CatalogueSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "created_at", "valid_at", "policy_version", "entries", "eligible_manifest_ids", "rejected_manifest_ids", "extensions"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "created_at": {"type": "string", "format": "date-time"},
    "valid_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest_ref", "category", "availability_class", "eligible", "reasons", "evidence_checked_at", "next_review_at"],
        "properties": {
          "manifest_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
          "category": {"enum": ["software", "model", "dataset", "adapter", "blueprint", "policy_pack", "external_service"]},
          "availability_class": {"enum": ["osi_open_source_software", "osi_open_source_ai", "open_weight_restricted", "source_available", "proprietary_hosted", "dataset_specific", "unknown"]},
          "eligible": {"type": "boolean"},
          "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_checked_at": {"type": "string", "format": "date-time"},
          "next_review_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "eligible_manifest_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "rejected_manifest_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  }
}
