{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oak.example/schemas/runner-plan.schema.json",
  "title": "RunnerPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "created_at",
    "expires_at",
    "design_case_ref",
    "bundle_ref",
    "target",
    "operations",
    "approvals",
    "supply_chain",
    "lease_policy",
    "evidence_policy",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "status": {
      "enum": ["draft", "signed", "approved", "leased", "running", "succeeded", "failed", "cancelled", "expired", "revoked", "manual_recovery_required"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "design_case_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "bundle_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
    "target": {"$ref": "#/$defs/target"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    },
    "approvals": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/approval"}
    },
    "supply_chain": {"$ref": "#/$defs/supplyChain"},
    "lease_policy": {"$ref": "#/$defs/leasePolicy"},
    "evidence_policy": {"$ref": "#/$defs/evidencePolicy"},
    "extensions": {"$ref": "common.schema.json#/$defs/extensions"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "tenant_id", "environment", "network_mode"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "fingerprint": {"$ref": "common.schema.json#/$defs/digest"},
        "tenant_id": {"type": "string", "minLength": 1},
        "environment": {"enum": ["development", "validation", "staging", "production"]},
        "network_mode": {"enum": ["local", "outbound_only", "private_bidirectional", "disconnected", "air_gapped"]}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "parameter_schema_digest"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "version": {"$ref": "common.schema.json#/$defs/semver"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"},
        "parameter_schema_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "reference", "scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "permissionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_types", "verbs", "namespaces", "network_destinations"],
      "properties": {
        "resource_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verbs": {"type": "array", "items": {"enum": ["get", "list", "create", "update", "patch", "delete", "execute"]}, "uniqueItems": true},
        "namespaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "network_destinations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds", "retryable_errors"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "backoff_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
        "retryable_errors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "adapter",
        "artifact_refs",
        "parameters",
        "secret_references",
        "permissions",
        "timeout_seconds",
        "retry_policy",
        "idempotency_key",
        "expected_state_digest",
        "failure_action",
        "depends_on"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "kind": {"enum": ["inventory", "validate", "render", "plan", "apply", "verify", "rollback", "destroy"]},
        "adapter": {"$ref": "#/$defs/adapter"},
        "artifact_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactRef"}},
        "parameters": {"type": "object"},
        "secret_references": {"type": "array", "items": {"$ref": "#/$defs/secretReference"}},
        "permissions": {"$ref": "#/$defs/permissionEnvelope"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "retry_policy": {"$ref": "#/$defs/retryPolicy"},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 240},
        "expected_state_digest": {
          "anyOf": [
            {"$ref": "common.schema.json#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "failure_action": {"enum": ["block", "rollback", "manual_recovery"]},
        "depends_on": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true}
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_digest", "signature_ref", "verification_policy_ref"],
      "properties": {
        "plan_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "signature_ref": {"$ref": "common.schema.json#/$defs/artifactRef"},
        "verification_policy_ref": {"$ref": "common.schema.json#/$defs/artifactRef"}
      }
    },
    "leasePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_seconds", "heartbeat_seconds", "require_nonce"],
      "properties": {
        "maximum_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "heartbeat_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "require_nonce": {"const": true}
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_categories", "maximum_bytes", "redact_fields"],
      "properties": {
        "allowed_categories": {
          "type": "array",
          "items": {"enum": ["inventory", "preflight", "plan_diff", "status", "test_result", "aggregate_metric", "drift", "incident_reference", "rollback_result"]},
          "uniqueItems": true
        },
        "maximum_bytes": {"type": "integer", "minimum": 0},
        "redact_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
